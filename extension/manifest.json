{
  "manifest_version": 3,
  "name": "תלם+ | Telem Plus",
  "short_name": "תלם+",
  "version": "1.1.1",
  "description": "ממשק חדש, נקי ומגניב למערכת תלם של עיריית תל אביב-יפו. עיצוב בלבד – לא משנה נתונים ולא שולח שום דבר.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "תלם+",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://telem.tel-aviv.gov.il/*"],
      "css": ["theme.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
